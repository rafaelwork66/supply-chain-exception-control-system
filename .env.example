# Copy this file to .env for local development.
# Do not commit .env because later stages may include private credentials.

SCECS_ENVIRONMENT=development
SCECS_LOG_LEVEL=INFO
SCECS_APP_NAME=Supply Chain Exception Control System

# Local PostgreSQL development database.
# These values are safe examples for Docker Compose local development only.
SCECS_DB_HOST=localhost
SCECS_DB_PORT=5432
SCECS_DB_NAME=scecs_dev
SCECS_DB_USER=scecs_user
SCECS_DB_PASSWORD=scecs_password
